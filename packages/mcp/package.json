{
  "name": "@browsermcp/mcp",
  "version": "2.5.1-ss.7",
  "description": "SS Chromium MCP server and daemon (bundled into the ss-chromium package; based on Browser MCP)",
  "author": "SS Chromium contributors; based on Browser MCP",
  "license": "Apache-2.0",
  "homepage": "https://github.com/LiquidLava1990/ss-chromium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiquidLava1990/ss-chromium.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/LiquidLava1990/ss-chromium/issues",
  "type": "module",
  "bin": {
    "mcp-server-browsermcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsup && shx chmod +x dist/index.js",
