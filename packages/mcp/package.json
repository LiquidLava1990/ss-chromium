    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@browsermcp/protocol": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.1",
    "shx": "^0.4.0",
    "tsup": "^8.5.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
